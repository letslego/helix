# Helix policy-engine sidecar
# Build: docker build -t helix-policy-sidecar:local -f Dockerfile.policy-sidecar .
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8181 \
    HELIX_POLICY_PACKS_DIR=/policies

RUN useradd --system --uid 10002 --create-home policy \
  && mkdir -p /policies /app \
  && chown -R policy:policy /policies /app

COPY --chown=policy:policy examples/policy-sidecar/server.mjs ./server.mjs
COPY --chown=policy:policy examples/travel-agent/agent/context/policies/ /policies/

USER policy
EXPOSE 8181
HEALTHCHECK --interval=10s --timeout=2s --start-period=3s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8181)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
